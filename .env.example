# === Brabo Tabacos API ===
PORT=8088
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=brabo_tabacos
DB_POOL_SIZE=5

# CORS (front local Brabo)
CORS_ORIGIN=http://127.0.0.1:43127,http://localhost:43127

# Admin seed (solo local/mock)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@brabotabacos.local
ADMIN_PASSWORD=CambiarYa123!

SUPERADMIN_EMAIL=superadmin@brabotabacos.local
SUPERADMIN_PASSWORD=CambiarYa123!

# JWT (cambiar en prod)
JWT_SECRET=cambiar-jwt-secret-brabo-local
JWT_EXPIRES_IN=8h

# Retail simple: reparaciones off
FEATURE_REPARACIONES=false

# WooCommerce off salvo que se configure
# WOOCOMMERCE_URL=
# WP_APPLICATION_USER=
# WP_APPLICATION_PASSWORD=

FEATURE_WOOCOMMERCE=false
APP_NAME=Brabo Tabacos
