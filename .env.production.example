# Copiá a .env en el VPS o dejá que scripts/bootstrap-prod.sh lo genere.
# NUNCA uses DB de prod mfcomputers.

NODE_ENV=production
PORT=8088

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=brabo
DB_PASSWORD=CAMBIAR_PASSWORD_FUERTE
DB_NAME=brabo_tabacos
DB_POOL_SIZE=10

# Front Brabo (HTTPS aurixerp.com)
CORS_ORIGIN=https://brabo.aurixerp.com

JWT_SECRET=CAMBIAR_JWT_LARGO
JWT_REFRESH_SECRET=CAMBIAR_JWT_REFRESH
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

FEATURE_REPARACIONES=false
API_KEY=CAMBIAR_API_KEY_POS

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@brabotabacos.local
ADMIN_PASSWORD=CAMBIAR_ADMIN
INIT_ADMIN_ON_START=true
INIT_SUPERADMIN_ON_START=false

FEATURE_WOOCOMMERCE=false
APP_NAME=Brabo Tabacos
