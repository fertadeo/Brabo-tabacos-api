{
  "name": "brabo-tabacos-api",
  "version": "1.0.0",
  "description": "API backend for Brabo Tabacos ERP (Aurix Retail instance)",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "migrate:roles": "node scripts/run-migration.js",
    "migrate:auth": "node scripts/run-auth-migration.js",
    "migrate:wc-slugs": "node scripts/backfill-woocommerce-slugs.js",
    "init:admin": "node scripts/create-admin-user.js",
    "init:n8n-key": "ts-node scripts/create-n8n-api-key.ts",
    "debug:arca-pdf": "ts-node scripts/debug-arca-pdf.ts",
    "recompress:stored-pdfs": "ts-node scripts/recompress-stored-pdfs.ts",
    "seed:brabo": "node scripts/seed-brabo-minimal.js"
  },
  "keywords": [
    "erp",
    "api",
    "nodejs",
    "typescript",
    "mysql"
  ],
  "author": "Fenec Studio",
  "license": "ISC",
  "dependencies": {
    "@googleapis/customsearch": "^7.0.1",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.6.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cheerio": "^1.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.5.0",
    "jest": "^29.6.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
